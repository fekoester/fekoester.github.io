---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
import Math from '../../components/Math.astro';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
---
<BaseLayout title={`${project.title} — Felix Köster`} description={project.summary}>
  <section class="project-hero">
    <div class="container">
      <a class="back" href="/projects">← All projects</a>
      <div class="meta mono"><span>{project.eyebrow}</span><span>{project.year}</span><span>{project.status}</span></div>
      <h1>{project.title}</h1>
      <p class="lede">{project.summary}</p>
      {project.links && <div class="button-row">{project.links.map((link) => <a class="button" href={link.href}>{link.label} ↗</a>)}</div>}
    </div>
  </section>
  <section class="section">
    <div class="container content-grid">
      <aside>
        <p class="kicker">Stack / topics</p>
        <ul class="tag-list">{project.tags.map((tag) => <li class="tag">{tag}</li>)}</ul>
      </aside>
      <article>
        {project.description.map((paragraph) => <p>{paragraph}</p>)}
        {project.equations && (
          <div class="equations">
            {project.equations.map((eq) => (
              <figure class="card eq">
                <Math tex={eq.tex} />
                {eq.caption && <figcaption>{eq.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )}
        {project.caveats && (
          <div class="caveats card">
            <p class="kicker">Caveats</p>
            {project.caveats.map((c) => <p>{c}</p>)}
          </div>
        )}
        {project.highlights && (
          <div class="highlights card">
            <p class="kicker">Highlights</p>
            <ul>{project.highlights.map((item) => <li>{item}</li>)}</ul>
          </div>
        )}
      </article>
    </div>
  </section>
</BaseLayout>
<style>
  .project-hero { padding: 70px 0 80px; }
  .back { display: inline-block; color: var(--muted); margin-bottom: 70px; font-size: .9rem; font-weight: 650; }
  .meta { display: flex; flex-wrap: wrap; gap: 22px; color: var(--accent); font-size: .78rem; text-transform: uppercase; letter-spacing: .12em; }
  h1 { max-width: 950px; margin: 22px 0 28px; }
  .content-grid { display: grid; grid-template-columns: 260px 1fr; gap: 90px; }
  article { max-width: 760px; }
  article > p { font-size: 1.12rem; line-height: 1.75; }
  .highlights, .caveats { padding: 24px; margin-top: 36px; }
  .caveats { border-color: color-mix(in srgb, #c08a2e 50%, var(--line)); }
  .caveats p:last-child { margin-bottom: 0; }
  .equations { display: grid; gap: 14px; margin: 36px 0; }
  .eq { margin: 0; padding: 18px 20px; overflow-x: auto; }
  figcaption { margin-top: 6px; color: var(--muted); font-size: .85rem; }
  .highlights ul { margin-bottom: 0; padding-left: 20px; }
  @media (max-width: 760px) { .content-grid { grid-template-columns: 1fr; gap: 45px; } .back { margin-bottom: 45px; } }
</style>
