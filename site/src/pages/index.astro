---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PublicationList from '../components/PublicationList.astro';
import Math from '../components/Math.astro';
import { site } from '../data/site';
import { featuredProjects } from '../data/projects';
import { selectedPublications, publications } from '../data/publications';
import { updates } from '../data/updates';
---
<BaseLayout>
  <section class="hero">
    <div class="container">
      <p class="kicker">{site.location} · Independent research</p>
      <h1 class="display">The physics<br />of learning machines.</h1>
      <div class="hero-bottom">
        <p class="lede">{site.intro}</p>
        <div class="role-stack mono">
          {site.roles.map((role, index) => <span><b>0{index + 1}</b> {role}</span>)}
        </div>
      </div>
      <div class="button-row">
        <a class="button primary" href="/research">Publications ({publications.length}) →</a>
        <a class="button" href="/projects">Projects &amp; code</a>
        <a class="button" href={site.links.github}>GitHub ↗</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="kicker">Two lines of research</p>
      <div class="pillars">
        <article class="pillar card">
          <p class="kicker">I · LLM training dynamics</p>
          <h2>Training as an action principle.</h2>
          <p>Forward pass, backprop and gradient flow are the Euler–Lagrange equations of one action. Data enters as a source and the optimizer metric as the kinetic term. That explains why data reweighting is zero-sum and why only the metric changes the learning path.</p>
          <div class="eq"><Math tex={String.raw`\mathcal{A} = \int dt\, e^{\gamma t}\Big(\tfrac{m}{2}\lVert\dot\theta\rVert^2 - \mathcal{S}[x,\lambda,\theta]\Big)`} /></div>
          <a class="text-link" href="/projects/llm-training-dynamics">The physics of LLM training →</a>
        </article>
        <article class="pillar card">
          <p class="kicker">II · Reservoir computing</p>
          <h2>Fix the dynamics. Learn the readout.</h2>
          <p>How much can a fixed, untrained dynamical system compute? With a state-dependent attention readout, a lot: better chaotic forecasting from smaller reservoirs, several attractors in one model, and language models trained without a single gradient through the reservoir.</p>
          <div class="eq"><Math tex={String.raw`\mathbf{r}_{t+1} = f\big(W\mathbf{r}_t + W_{\text{in}}\mathbf{u}_t\big),\quad \hat{\mathbf{y}}_t = W_{\text{out}}(\mathbf{r}_t)\,\mathbf{r}_t`} /></div>
          <a class="text-link" href="/projects/reservoir-language-model">Reservoir computing as a language model →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><p class="kicker">Selected work</p><h2>Projects</h2></div>
        <p>Papers come with code. Side projects come with equations.</p>
      </div>
      <div class="grid three">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
      <div class="button-row"><a class="button" href="/projects">All projects →</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><p class="kicker">Research</p><h2>Selected publications</h2></div>
        <a class="text-link" href="/research">All {publications.length} publications →</a>
      </div>
      <PublicationList items={selectedPublications} numbered={false} />
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div><p class="kicker">Log</p><h2>Recent updates</h2></div>
      <ul class="rule-list updates">
        {updates.map((u) => (
          <li><span class="mono date">{u.date}</span>{u.href ? <a href={u.href}>{u.text}</a> : <span>{u.text}</span>}</li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: clamp(70px, 11vw, 140px) 0 90px; }
  .hero h1 { margin-bottom: 45px; }
  .hero-bottom { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(240px, .7fr); gap: 60px; align-items: end; }
  .hero-bottom .lede { margin-bottom: 0; }
  .role-stack { display: grid; gap: 8px; color: var(--muted); font-size: 0.85rem; }
  .role-stack span { display: flex; gap: 16px; }
  .role-stack b { color: var(--accent); }
  .split { display: grid; grid-template-columns: .9fr 1.1fr; gap: 80px; }
  .focus-copy p { font-size: 1.08rem; }
  .pillars { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .pillar { padding: clamp(22px, 3vw, 36px); display: flex; flex-direction: column; min-width: 0; }
  .pillar h2 { font-size: clamp(1.7rem, 3vw, 2.5rem); margin-bottom: 18px; }
  .pillar .text-link { margin-top: auto; }
  .eq { padding: 14px 0; margin: 0 0 18px; overflow-x: auto; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .text-link { color: var(--accent); font-weight: 750; }
  .updates li { display: grid; grid-template-columns: 90px 1fr; gap: 20px; }
  .updates .date { color: var(--accent); font-size: .8rem; padding-top: 3px; }
  .updates a { text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 4px; }
  @media (max-width: 780px) {
    .hero-bottom, .split, .pillars { grid-template-columns: 1fr; gap: 34px; }
    .updates li { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
