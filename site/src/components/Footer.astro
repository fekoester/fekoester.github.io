---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer>
  <div class="container footer-grid">
    <div>
      <strong>{site.name}</strong>
      <p>Theoretical physics × machine learning. Built with Astro, hosted on GitHub Pages.</p>
    </div>
    <div class="links">
      {site.links.github && <a href={site.links.github}>GitHub</a>}
      {site.links.linkedin && <a href={site.links.linkedin}>LinkedIn</a>}
      {site.links.scholar && <a href={site.links.scholar}>Scholar</a>}
      {site.links.email && <a href={site.links.email}>Email</a>}
    </div>
    <div class="copyright">© {year} {site.name} · Last updated {site.updated}</div>
  </div>
</footer>
<style>
  footer { padding: 38px 0 54px; border-top: 1px solid var(--line); }
  .footer-grid { display: grid; grid-template-columns: 1fr auto; gap: 28px; align-items: end; }
  strong { letter-spacing: -0.02em; }
  p { margin: 4px 0 0; font-size: 0.9rem; }
  .links { display: flex; flex-wrap: wrap; gap: 18px; font-size: 0.9rem; font-weight: 650; }
  .copyright { grid-column: 1 / -1; color: var(--muted); font-size: 0.78rem; }
  @media (max-width: 650px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
