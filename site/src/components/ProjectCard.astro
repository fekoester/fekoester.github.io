---
import type { ShowcasedProject } from '../data/projects';
import { categoryLabel } from '../data/labels';
interface Props { project: ShowcasedProject; size?: 'default' | 'large'; eager?: boolean }
const { project, size = 'default', eager = false } = Astro.props;
const large = size === 'large';
---
<article class:list={['pcard', large && 'large']} data-category={project.category}>
  <a href={`/projects/${project.slug}`} class="pcard-link">
    <div class="pcard-media" data-hover-video={project.coverVideo}>
      <img
        src={large ? project.cover : project.coverSmall}
        srcset={`${project.coverSmall} 640w, ${project.cover} 1280w`}
        sizes={large ? '(max-width: 780px) 100vw, 600px' : '(max-width: 780px) 100vw, 380px'}
        width="1280" height="800" alt={project.coverAlt}
        loading={eager ? 'eager' : 'lazy'} decoding="async"
      />
      <div class="pcard-badges">
        <span class="badge">{categoryLabel[project.category]}</span>
        {project.demo && <span class="badge live"><span class="pulse" aria-hidden="true"></span>Live demo</span>}
        {project.coverVideo && <span class="badge play" aria-hidden="true">▶</span>}
      </div>
    </div>
    <div class="pcard-body">
      <div class="pcard-meta"><span>{project.eyebrow}</span><span>{project.year}</span></div>
      <h3>{project.title}</h3>
      <p>{project.summary}</p>
      <div class="pcard-foot">
        <span class="status mono" data-status={project.status}>{project.status}</span>
        <span class="arrow" aria-hidden="true">→</span>
      </div>
    </div>
  </a>
</article>

<style>
  .pcard {
    border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface);
    box-shadow: var(--shadow); overflow: hidden; transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }
  .pcard:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--accent) 55%, var(--line)); box-shadow: 0 22px 70px rgba(0,0,0,.16); }
  .pcard[hidden] { display: none; }
  .pcard-link { display: flex; flex-direction: column; height: 100%; color: inherit; }
  .pcard-link:hover { color: inherit; }
  .pcard-link:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; border-radius: var(--radius); }
  .pcard-media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--media-bg); }
  .pcard-media img, .pcard-media :global(video) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 600ms cubic-bezier(.2,.7,.2,1), opacity 300ms ease; }
  .pcard-media :global(video) { opacity: 0; }
  .pcard-media.playing :global(video) { opacity: 1; }
  .pcard:hover .pcard-media img { transform: scale(1.045); }
  .pcard-badges { position: absolute; left: 12px; right: 12px; top: 12px; display: flex; gap: 6px; align-items: center; pointer-events: none; }
  .badge {
    display: inline-flex; align-items: center; gap: 6px; padding: 4px 9px; border-radius: 999px;
    background: rgba(12, 17, 15, .72); color: #eef1ea; backdrop-filter: blur(8px);
    font-size: .68rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
  }
  .badge.live { color: #c9ecd9; }
  .badge.play { margin-left: auto; width: 26px; height: 26px; justify-content: center; padding: 0; font-size: .62rem; letter-spacing: 0; }
  .pulse { width: 7px; height: 7px; border-radius: 50%; background: #7ee0a6; box-shadow: 0 0 0 0 rgba(126,224,166,.6); animation: pulse 2.2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 7px rgba(126,224,166,0); } 100% { box-shadow: 0 0 0 0 rgba(126,224,166,0); } }
  .pcard-body { display: flex; flex-direction: column; flex: 1; padding: 20px 22px 18px; }
  .pcard-meta { display: flex; justify-content: space-between; gap: 14px; color: var(--accent); font-size: .7rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  h3 { margin: 10px 0 10px; font-size: 1.38rem; }
  p { margin-bottom: 18px; font-size: .95rem; display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .pcard-foot { margin-top: auto; display: flex; justify-content: space-between; align-items: center; padding-top: 14px; border-top: 1px solid var(--line); }
  .status { color: var(--muted); font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; }
  .status[data-status='Live']::before, .status[data-status='Published']::before { content: '●'; margin-right: 6px; color: var(--accent); }
  .status[data-status='Research in progress']::before, .status[data-status='Active']::before { content: '◐'; margin-right: 6px; color: var(--amber); }
  .arrow { color: var(--accent); font-weight: 800; transition: transform 200ms ease; }
  .pcard:hover .arrow { transform: translateX(4px); }
  .large h3 { font-size: clamp(1.6rem, 2.6vw, 2.15rem); }
  .large p { font-size: 1.02rem; -webkit-line-clamp: 4; line-clamp: 4; }
  .large .pcard-body { padding: 24px 26px 22px; }
</style>
