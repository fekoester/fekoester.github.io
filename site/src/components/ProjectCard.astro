---
import type { Project } from '../data/projects';
interface Props { project: Project; }
const { project } = Astro.props;
const glyph = { Research: '∂', Software: '⌘', Experiment: '∿', Simulation: '∞' }[project.category];
---
<article class="card project-card" data-category={project.category}>
  <a href={`/projects/${project.slug}`} class="card-link" aria-label={`Open ${project.title}`}>
    <div class="topline">
      <span>{project.eyebrow}</span>
      <span>{project.year}</span>
    </div>
    <div class="visual" aria-hidden="true">
      <span class="glyph">{glyph}</span>
      <div class="orbit"></div>
      <span class="status mono">{project.status}</span>
    </div>
    <div class="body">
      <h3>{project.title}</h3>
      <p>{project.summary}</p>
      <ul class="tag-list">
        {project.tags.slice(0, 4).map((tag) => <li class="tag">{tag}</li>)}
      </ul>
    </div>
  </a>
</article>
<style>
  .project-card { overflow: hidden; transition: transform 180ms ease, border-color 180ms ease; }
  .project-card:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--accent) 55%, var(--line)); }
  .card-link { display: flex; flex-direction: column; height: 100%; color: inherit; }
  .card-link:hover { color: inherit; }
  .topline { display: flex; justify-content: space-between; gap: 20px; padding: 16px 18px; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  .visual { height: 130px; position: relative; overflow: hidden; background: linear-gradient(135deg, var(--accent-soft), transparent 60%); border-bottom: 1px solid var(--line); }
  .glyph { position: absolute; left: 20px; bottom: -22px; font-size: 7rem; line-height: 1; font-family: Georgia, serif; color: color-mix(in srgb, var(--accent) 30%, transparent); }
  .status { position: absolute; right: 16px; bottom: 12px; font-size: .7rem; color: var(--accent); text-transform: uppercase; letter-spacing: .08em; }
  .orbit { position: absolute; width: 130px; height: 130px; border: 1px solid var(--accent); border-radius: 50%; top: 18px; right: 38px; opacity: 0.3; }
  .orbit::before, .orbit::after { content: ''; position: absolute; border-radius: 50%; border: 1px solid var(--accent); inset: 22px; }
  .orbit::after { inset: 52px; background: var(--accent); }
  .body { padding: 22px; }
  h3 { margin-bottom: 10px; font-size: 1.4rem; }
  p { margin-bottom: 0; }
</style>
