---
import DemoFrame from '../DemoFrame.astro';
---
<DemoFrame title="Synchronisation as a representation" note="Illustration, runs in your browser">
  <div slot="intro">
    <p>A Continuous Thought Machine does not read out neuron activations directly. It reads how pairs of neurons move together over its internal ticks: the synchronisation matrix S<sub>ij</sub>, accumulated with a decay. In this toy, 24 phase oscillators stand in for neurons. Different “inputs” couple different groups, and S takes on a different block structure.</p>
  </div>
  <div class="sy" data-demo="sync">
    <div class="demo-controls">
      <label>coupling <input type="range" name="K" id="sy-k" min="0" max="4" step="0.05" value="2.2" /><output for="sy-k"></output></label>
      <label>decay <input type="range" name="decay" id="sy-d" min="0.9" max="0.995" step="0.001" value="0.98" /><output for="sy-d"></output></label>
      <button class="demo-btn primary" data-act="input">New input</button>
    </div>
    <div class="panes">
      <canvas class="demo-canvas traces" aria-label="Neuron traces over internal ticks"></canvas>
      <canvas class="demo-canvas mat" aria-label="Synchronisation matrix"></canvas>
    </div>
    <div class="demo-readout"><span>input pattern <b class="pat">–</b></span><span>mean |S| within groups <b class="win">–</b> · between <b class="btw">–</b></span></div>
  </div>
  <div slot="foot"><p>An illustration of the idea, not the trained CIFAR model. In the real CTM, each neuron’s dynamics come from a small private network over its own history.</p></div>
</DemoFrame>

<script>
  import { setupCanvas, bindRange, visibleLoop, rng, MEDIA, reducedMotion } from '../../lib/demo';

  document.querySelectorAll<HTMLElement>('[data-demo="sync"]').forEach((root) => {
    const N = 24, DT = 0.03;
    let K = 2.2, decay = 0.98, inputSeed = 1;
    let group = new Int32Array(N), omega = new Float64Array(N), th = new Float64Array(N);
    const S = new Float64Array(N * N);
    const hist: Float64Array[] = [];
    const tr = setupCanvas(root.querySelector<HTMLCanvasElement>('.traces')!, 1.35, () => drawTraces());
    const mt = setupCanvas(root.querySelector<HTMLCanvasElement>('.mat')!, 1, () => drawMat());
    const cols = [MEDIA.mint, MEDIA.amber, MEDIA.sky, MEDIA.violet];

    function newInput() {
      const R = rng(inputSeed++);
      const G = 2 + Math.floor(R.next() * 3); // 2..4 groups
      for (let i = 0; i < N; i++) group[i] = Math.floor(R.next() * G);
      const base = Array.from({ length: G }, () => 0.6 + R.next() * 1.6);
      for (let i = 0; i < N; i++) { omega[i] = base[group[i]] + 0.35 * R.normal(); th[i] = R.next() * 6.283; }
      S.fill(0);
      const counts = Array.from({ length: G }, (_, g) => [...group].filter((x) => x === g).length);
      root.querySelector('.pat')!.textContent = `${G} groups (${counts.join(' + ')})`;
    }

    function tick() {
      const z = new Float64Array(N);
      for (let s = 0; s < 3; s++) {
        const d = new Float64Array(N);
        for (let i = 0; i < N; i++) {
          let c = 0, m = 0;
          for (let j = 0; j < N; j++) if (group[j] === group[i] && j !== i) { c += Math.sin(th[j] - th[i]); m++; }
          d[i] = omega[i] + (m ? (K * c) / m : 0);
        }
        for (let i = 0; i < N; i++) th[i] += DT * d[i];
      }
      for (let i = 0; i < N; i++) z[i] = Math.sin(th[i]);
      for (let i = 0; i < N; i++) for (let j = 0; j < N; j++) S[i * N + j] = decay * S[i * N + j] + (1 - decay) * z[i] * z[j] * 2;
      hist.push(z); if (hist.length > 260) hist.shift();
    }

    // order neurons by group for display
    const order = () => [...Array(N).keys()].sort((a, b) => group[a] - group[b] || a - b);

    function drawTraces() {
      const { ctx, w, h } = tr;
      if (!w) return;
      ctx.fillStyle = MEDIA.bg; ctx.fillRect(0, 0, w, h);
      const ord = order(), rowH = (h - 16) / N;
      ord.forEach((i, r) => {
        ctx.strokeStyle = cols[group[i] % 4]; ctx.lineWidth = 1.3; ctx.beginPath();
        hist.forEach((z, k) => {
          const x = (k / 259) * w, y = 8 + r * rowH + rowH / 2 - z[i] * rowH * 0.42;
          k ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
        });
        ctx.stroke();
      });
      ctx.fillStyle = MEDIA.muted; ctx.font = '11px Inter, system-ui, sans-serif'; ctx.textAlign = 'right'; ctx.fillText('internal ticks →', w - 8, h - 4);
    }
    function drawMat() {
      const { ctx, w, h } = mt;
      if (!w) return;
      ctx.fillStyle = MEDIA.bg; ctx.fillRect(0, 0, w, h);
      const ord = order(), pad = 10, c = (Math.min(w, h) - 2 * pad) / N;
      let win = 0, nw = 0, btw = 0, nb = 0;
      ord.forEach((i, r) => ord.forEach((j, q) => {
        const v = Math.max(-1, Math.min(1, S[i * N + j]));
        if (i !== j) { if (group[i] === group[j]) { win += Math.abs(v); nw++; } else { btw += Math.abs(v); nb++; } }
        ctx.fillStyle = v >= 0 ? `rgba(227,168,87,${v.toFixed(3)})` : `rgba(127,176,216,${(-v).toFixed(3)})`;
        ctx.fillRect(pad + q * c + 0.5, pad + r * c + 0.5, c - 1, c - 1);
      }));
      root.querySelector('.win')!.textContent = (win / Math.max(1, nw)).toFixed(2);
      root.querySelector('.btw')!.textContent = (btw / Math.max(1, nb)).toFixed(2);
    }

    newInput();
    for (let k = 0; k < 60; k++) tick();
    const loop = visibleLoop(root, () => { tick(); drawTraces(); drawMat(); });
    if (reducedMotion()) loop.paused = true;
    bindRange(root, 'K', (v) => v.toFixed(2), (v) => { K = v; });
    bindRange(root, 'decay', (v) => v.toFixed(3), (v) => { decay = v; });
    root.querySelector('[data-act="input"]')!.addEventListener('click', newInput);
  });
</script>

<style>
  .sy { display: grid; gap: 14px; }
  .panes { display: grid; grid-template-columns: 1.35fr 1fr; gap: 12px; align-items: start; }
  @media (max-width: 680px) { .panes { grid-template-columns: 1fr; } }
</style>
