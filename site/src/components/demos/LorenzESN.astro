---
import DemoFrame from '../DemoFrame.astro';
---
<DemoFrame title="Forecast the Lorenz system with a reservoir">
  <div slot="intro">
    <p>A random reservoir is driven by the Lorenz-63 system for 80 time units, and a ridge readout learns the next step. Then the loop is closed: the reservoir runs on its own predictions. Shrink the reservoir and watch the forecast fail early. That small-reservoir regime is where the attention readout of AERC helps most.</p>
  </div>
  <div class="lz" data-demo="lorenz-esn">
    <div class="demo-controls">
      <label>reservoir nodes <input type="range" name="n" id="lz-n" min="10" max="400" step="10" value="200" /><output for="lz-n"></output></label>
      <label>spectral radius <input type="range" name="rho" id="lz-rho" min="0.1" max="1.5" step="0.05" value="0.9" /><output for="lz-rho"></output></label>
      <button class="demo-btn primary" data-act="run">Train &amp; forecast</button>
      <button class="demo-btn" data-act="seed">New random reservoir</button>
    </div>
    <div class="panes">
      <canvas class="demo-canvas ts" aria-label="True and predicted x(t) in Lyapunov times"></canvas>
      <canvas class="demo-canvas att" aria-label="True and predicted attractor, x against z"></canvas>
    </div>
    <div class="demo-readout">
      <span><span class="legend-dot" style="background:#7fb0d8"></span>true Lorenz</span>
      <span><span class="legend-dot" style="background:#e3a857"></span>reservoir forecast (closed loop)</span>
      <span>valid prediction time: <b class="vpt">–</b></span>
      <span class="info"></span>
    </div>
  </div>
  <div slot="foot"><p>Valid prediction time: the forecast horizon until the normalised error exceeds 0.4, in Lyapunov times (λ ≈ 0.906), as in the AERes benchmark. Readout features: the state with every second unit squared, plus a bias.</p></div>
</DemoFrame>

<script>
  import { setupCanvas, rng, reservoirMatrix, ridgeSolve, bindRange, visibleLoop, MEDIA } from '../../lib/demo';

  document.querySelectorAll<HTMLElement>('[data-demo="lorenz-esn"]').forEach((root) => {
    const DT = 0.02, LYAP = 0.906, TRAIN = 4000, WASH = 300, PRED = 900;
    // Lorenz-63, RK4 with dt = 0.01, sampled every 0.02, normalised per component
    const U: number[][] = [];
    {
      let v = [1, 1, 1];
      const f = (p: number[]) => [10 * (p[1] - p[0]), p[0] * (28 - p[2]) - p[1], p[0] * p[1] - (8 / 3) * p[2]];
      const h = 0.01;
      for (let i = 0; i < 2000 + (TRAIN + PRED + 2) * 2; i++) {
        const k1 = f(v), k2 = f(v.map((x, j) => x + (h / 2) * k1[j])), k3 = f(v.map((x, j) => x + (h / 2) * k2[j])), k4 = f(v.map((x, j) => x + h * k3[j]));
        v = v.map((x, j) => x + (h / 6) * (k1[j] + 2 * k2[j] + 2 * k3[j] + k4[j]));
        if (i >= 2000 && (i - 2000) % 2 === 0) U.push(v);
      }
      const mu = [0, 1, 2].map((j) => U.reduce((s, u) => s + u[j], 0) / U.length);
      const sd = [0, 1, 2].map((j) => Math.sqrt(U.reduce((s, u) => s + (u[j] - mu[j]) ** 2, 0) / U.length));
      for (const u of U) for (let j = 0; j < 3; j++) u[j] = (u[j] - mu[j]) / sd[j];
    }

    let N = 200, rho = 0.9, seed = 1, busy = false;
    let pred: number[][] = [], vptSteps = 0, shown = 0;
    const ts = setupCanvas(root.querySelector<HTMLCanvasElement>('.ts')!, 1.6, () => draw());
    const at = setupCanvas(root.querySelector<HTMLCanvasElement>('.att')!, 1.6, () => draw());
    const $ = (s: string) => root.querySelector(s)!;
    const yieldFrame = () => new Promise((r) => setTimeout(r, 0));

    const feat = (x: Float64Array, f: Float64Array) => {
      for (let i = 0; i < x.length; i++) f[i] = i % 2 ? x[i] * x[i] : x[i];
      f[x.length] = 1;
    };

    async function run() {
      if (busy) return;
      busy = true;
      $('.vpt').textContent = 'training…';
      const t0 = performance.now();
      const R = rng(seed * 7919);
      const n = N, D = n + 1;
      const W = reservoirMatrix(n, Math.min(1, 6 / n), rho, R);
      const Win = new Float64Array(n * 3).map(() => (R.next() * 2 - 1) * 0.1);
      const x = new Float64Array(n), tmp = new Float64Array(n), f = new Float64Array(D);
      const A = new Float64Array(D * D), B = new Float64Array(D * 3);
      const update = (u: number[]) => {
        for (let i = 0; i < n; i++) {
          let s = Win[i * 3] * u[0] + Win[i * 3 + 1] * u[1] + Win[i * 3 + 2] * u[2];
          const row = i * n;
          for (let j = 0; j < n; j++) s += W[row + j] * x[j];
          tmp[i] = Math.tanh(s);
        }
        x.set(tmp);
      };
      for (let t = 0; t < TRAIN; t++) {
        update(U[t]);
        if (t >= WASH) {
          feat(x, f);
          const y = U[t + 1];
          for (let i = 0; i < D; i++) {
            const fi = f[i], row = i * D;
            for (let j = i; j < D; j++) A[row + j] += fi * f[j];
            B[i * 3] += fi * y[0]; B[i * 3 + 1] += fi * y[1]; B[i * 3 + 2] += fi * y[2];
          }
        }
        if (t % 500 === 0) await yieldFrame();
      }
      for (let i = 0; i < D; i++) for (let j = i + 1; j < D; j++) A[j * D + i] = A[i * D + j];
      const Wo = ridgeSolve(A, B, D, 3, 1e-6);
      const readout = () => {
        feat(x, f);
        const o = [0, 0, 0];
        for (let i = 0; i < D; i++) { o[0] += f[i] * Wo[i * 3]; o[1] += f[i] * Wo[i * 3 + 1]; o[2] += f[i] * Wo[i * 3 + 2]; }
        return o;
      };
      // closed loop
      pred = [];
      let u = readout();
      for (let k = 0; k < PRED; k++) {
        if (!u.every(Number.isFinite) || Math.abs(u[0]) > 50) u = [NaN, NaN, NaN];
        pred.push(u);
        if (Number.isNaN(u[0])) continue;
        update(u);
        u = readout();
      }
      let norm = 0;
      for (let k = 0; k < PRED; k++) norm += U[TRAIN + k].reduce((s, v) => s + v * v, 0);
      norm = Math.sqrt(norm / PRED);
      vptSteps = PRED;
      for (let k = 0; k < PRED; k++) {
        const e = Math.hypot(...pred[k].map((v, j) => v - U[TRAIN + k][j])) / norm;
        if (!(e <= 0.4)) { vptSteps = k; break; }
      }
      const vpt = vptSteps * DT * LYAP;
      $('.vpt').textContent = `${vpt.toFixed(2)} Lyapunov times${vptSteps === PRED ? '+' : ''}`;
      $('.info').textContent = `${n} nodes, trained in ${((performance.now() - t0) / 1000).toFixed(1)} s`;
      shown = 0;
      busy = false;
    }

    function draw() {
      if (!ts.w || !at.w) return;
      // time series
      {
        const { ctx, w, h } = ts;
        ctx.fillStyle = MEDIA.bg; ctx.fillRect(0, 0, w, h);
        const pad = { l: 14, r: 14, t: 18, b: 30 };
        const tmax = PRED * DT * LYAP;
        const tx = (k: number) => pad.l + (k / PRED) * (w - pad.l - pad.r);
        const ty = (v: number) => pad.t + (1 - (v + 2.6) / 5.2) * (h - pad.t - pad.b);
        ctx.strokeStyle = MEDIA.grid; ctx.lineWidth = 1; ctx.fillStyle = MEDIA.muted; ctx.font = '11px Inter, system-ui, sans-serif'; ctx.textAlign = 'center';
        for (let L = 0; L <= tmax; L += 2) {
          const x = tx(L / (DT * LYAP)); ctx.beginPath(); ctx.moveTo(x, pad.t); ctx.lineTo(x, h - pad.b); ctx.stroke();
          ctx.fillText(`${L} Λt`, x, h - pad.b + 16);
        }
        const path = (get: (k: number) => number, upto: number, color: string, width: number) => {
          ctx.strokeStyle = color; ctx.lineWidth = width; ctx.beginPath();
          let pen = false;
          for (let k = 0; k < upto; k++) {
            const v = get(k);
            if (!Number.isFinite(v)) { pen = false; continue; }
            const X = tx(k), Y = ty(Math.max(-2.6, Math.min(2.6, v)));
            if (pen) ctx.lineTo(X, Y); else { ctx.moveTo(X, Y); pen = true; }
          }
          ctx.stroke();
        };
        path((k) => U[TRAIN + k][0], PRED, MEDIA.sky, 1.6);
        if (pred.length) path((k) => pred[k][0], Math.min(shown, PRED), MEDIA.amber, 2);
        if (pred.length && shown >= vptSteps && vptSteps < PRED) {
          const x = tx(vptSteps);
          ctx.setLineDash([4, 4]); ctx.strokeStyle = MEDIA.coral; ctx.beginPath(); ctx.moveTo(x, pad.t); ctx.lineTo(x, h - pad.b); ctx.stroke(); ctx.setLineDash([]);
          ctx.fillStyle = MEDIA.coral; ctx.textAlign = 'left'; ctx.fillText('error > 0.4', x + 6, pad.t + 10);
        }
        ctx.fillStyle = MEDIA.muted; ctx.textAlign = 'left'; ctx.fillText('x(t)', pad.l + 2, pad.t - 4);
      }
      // attractor (x, z)
      {
        const { ctx, w, h } = at;
        ctx.fillStyle = MEDIA.bg; ctx.fillRect(0, 0, w, h);
        const sx = (v: number) => w / 2 + v * w * 0.2, sy = (v: number) => h / 2 - v * h * 0.28;
        ctx.strokeStyle = 'rgba(127,176,216,0.35)'; ctx.lineWidth = 1; ctx.beginPath();
        for (let k = 0; k < TRAIN; k++) { const u = U[k]; if (k) ctx.lineTo(sx(u[0]), sy(u[2])); else ctx.moveTo(sx(u[0]), sy(u[2])); }
        ctx.stroke();
        if (pred.length) {
          ctx.strokeStyle = MEDIA.amber; ctx.lineWidth = 1.6; ctx.beginPath();
          let pen = false;
          for (let k = 0; k < Math.min(shown, PRED); k++) {
            const u = pred[k];
            if (!Number.isFinite(u[0]) || Math.abs(u[0]) > 4 || Math.abs(u[2]) > 4) { pen = false; continue; }
            if (pen) ctx.lineTo(sx(u[0]), sy(u[2])); else { ctx.moveTo(sx(u[0]), sy(u[2])); pen = true; }
          }
          ctx.stroke();
          const last = pred[Math.min(shown, PRED) - 1];
          if (last && Number.isFinite(last[0])) { ctx.fillStyle = MEDIA.text; ctx.beginPath(); ctx.arc(sx(last[0]), sy(last[2]), 3.5, 0, 7); ctx.fill(); }
        }
        ctx.fillStyle = MEDIA.muted; ctx.font = '11px Inter, system-ui, sans-serif'; ctx.fillText('x', w - 16, h / 2 + 14); ctx.fillText('z', w / 2 + 6, 14);
      }
    }

    visibleLoop(root, (dt) => {
      if (pred.length && shown < PRED) { shown = Math.min(PRED, shown + Math.ceil(dt * 260)); draw(); }
    });
    bindRange(root, 'n', (v) => String(v), (v) => { N = v; });
    bindRange(root, 'rho', (v) => v.toFixed(2), (v) => { rho = v; });
    $('[data-act="run"]').addEventListener('click', run);
    $('[data-act="seed"]').addEventListener('click', () => { seed++; run(); });
    new IntersectionObserver((e, obs) => { if (e[0].isIntersecting) { obs.disconnect(); run(); } }).observe(root);
  });
</script>

<style>
  .lz { display: grid; gap: 14px; }
  .panes { display: grid; grid-template-columns: 1.25fr 1fr; gap: 12px; }
  @media (max-width: 680px) { .panes { grid-template-columns: 1fr; } }
</style>
