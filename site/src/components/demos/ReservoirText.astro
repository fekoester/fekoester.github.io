---
import DemoFrame from '../DemoFrame.astro';
---
<DemoFrame title="Train a reservoir language model in your browser">
  <div slot="intro">
    <p>A random, fixed recurrent network reads about 5,000 characters of Shakespeare. Only the linear readout is trained, in one closed-form ridge regression and with no gradients. It is then scored on held-out lines against a readout that sees only the current character (a bigram model), and it writes.</p>
  </div>
  <div class="rtext" data-demo="reservoir-text">
    <div class="demo-controls">
      <label>reservoir units <input type="range" name="n" id="rt-n" min="40" max="400" step="20" value="240" /><output for="rt-n"></output></label>
      <label>spectral radius <input type="range" name="rho" id="rt-rho" min="0.1" max="1.4" step="0.05" value="0.9" /><output for="rt-rho"></output></label>
      <label>temperature <input type="range" name="temp" id="rt-temp" min="0.03" max="0.4" step="0.01" value="0.12" /><output for="rt-temp"></output></label>
    </div>
    <div class="demo-controls">
      <button class="demo-btn primary" data-act="train">Train readout</button>
      <label class="prompt">prompt <input type="text" name="prompt" value="to be, or not" maxlength="60" spellcheck="false" /></label>
      <button class="demo-btn" data-act="gen">Write</button>
    </div>
    <div class="scores">
      <div class="score"><span>held-out next-char accuracy</span><b class="acc-res">–</b><em>reservoir + readout</em></div>
      <div class="score"><span>same readout, no reservoir</span><b class="acc-bi">–</b><em>current character only</em></div>
      <div class="score"><span>training</span><b class="status">waiting</b><em class="timing">&nbsp;</em></div>
    </div>
    <canvas class="demo-canvas states" aria-label="Reservoir activations while generating, one column per character"></canvas>
    <pre class="out" aria-live="polite"><span class="p"></span><span class="g"></span><span class="cursor">▍</span></pre>
  </div>
  <div slot="foot"><p>Expect Shakespeare-flavoured nonsense: the corpus is tiny and the readout linear. The point is what the gap between the two accuracies shows: the context a fixed random dynamical system carries for free.</p></div>
</DemoFrame>

<script>
  import { setupCanvas, rng, reservoirMatrix, ridgeSolve, bindRange, visibleLoop, MEDIA } from '../../lib/demo';
  import { SHAKESPEARE } from '../../lib/shakespeare';

  document.querySelectorAll<HTMLElement>('[data-demo="reservoir-text"]').forEach((root) => {
    const text = SHAKESPEARE;
    const vocab = [...new Set(text)].sort();
    const V = vocab.length;
    const idx = new Map(vocab.map((c, i) => [c, i]));
    const ids = Int32Array.from(text, (c) => idx.get(c)!);
    const L = ids.length, split = Math.floor(L * 0.85), washout = 30, leak = 0.55;

    let N = 240, rho = 0.9, temp = 0.12;
    let model: null | { N: number; W: Float32Array; Win: Float32Array; Wout: Float64Array } = null;
    let busy = false;

    const $ = (s: string) => root.querySelector(s)!;
    const cv = setupCanvas(root.querySelector<HTMLCanvasElement>('.states')!, 5.2, () => clearStates());
    const shown = 48;
    let col = 0;
    function clearStates() { cv.ctx.fillStyle = MEDIA.bg; cv.ctx.fillRect(0, 0, cv.w, cv.h); col = 0; }
    function drawState(r: Float32Array) {
      const { ctx, w, h } = cv;
      const cw = 6, ch = h / shown;
      if ((col + 1) * cw > w) { // scroll left by one column
        const ratio = ctx.canvas.width / w;
        const img = ctx.getImageData(Math.round(cw * ratio), 0, ctx.canvas.width - Math.round(cw * ratio), ctx.canvas.height);
        ctx.putImageData(img, 0, 0);
        col = Math.floor(w / cw) - 1;
      }
      for (let i = 0; i < shown; i++) {
        const v = Math.max(-1, Math.min(1, r[i] * 1.6));
        ctx.fillStyle = MEDIA.bg; ctx.fillRect(col * cw, i * ch, cw, ch);
        ctx.fillStyle = v >= 0 ? `rgba(227,168,87,${v.toFixed(3)})` : `rgba(127,176,216,${(-v).toFixed(3)})`;
        ctx.fillRect(col * cw + 0.5, i * ch + 0.5, cw - 1, ch - 1);
      }
      col++;
    }

    function step(m: NonNullable<typeof model>, r: Float32Array, c: number, tmp: Float32Array) {
      const { N: n, W, Win } = m;
      for (let i = 0; i < n; i++) {
        let s = Win[i * V + c];
        const row = i * n;
        for (let j = 0; j < n; j++) s += W[row + j] * r[j];
        tmp[i] = s;
      }
      for (let i = 0; i < n; i++) r[i] = (1 - leak) * r[i] + leak * Math.tanh(tmp[i]);
    }

    const frame = () => new Promise((res) => setTimeout(res, 0));

    async function train() {
      if (busy) return;
      busy = true;
      const t0 = performance.now();
      const R = rng(7);
      const n = N;
      const W = Float32Array.from(reservoirMatrix(n, Math.min(1, 12 / n), rho, R));
      const Win = new Float32Array(n * V).map(() => (R.next() * 2 - 1) * 0.9);
      const D = n + V + 1;
      const A = new Float64Array(D * D), B = new Float64Array(D * V);
      const r = new Float32Array(n), tmp = new Float32Array(n);
      const m: { N: number; W: Float32Array; Win: Float32Array; Wout: Float64Array } = { N: n, W, Win, Wout: new Float64Array(0) };
      $('.status').textContent = 'reading 0%';
      for (let t = 0; t < split - 1; t++) {
        step(m, r, ids[t], tmp);
        if (t >= washout) {
          const c = ids[t], y = ids[t + 1];
          for (let i = 0; i < n; i++) {
            const ri = r[i], row = i * D;
            for (let j = i; j < n; j++) A[row + j] += ri * r[j];
            A[row + n + c] += ri;
            A[row + D - 1] += ri;
            B[i * V + y] += ri;
          }
          A[(n + c) * D + n + c] += 1;
          A[(n + c) * D + D - 1] += 1;
          A[(D - 1) * D + D - 1] += 1;
          B[(n + c) * V + y] += 1;
          B[(D - 1) * V + y] += 1;
        }
        if (t % 600 === 0) { $('.status').textContent = `reading ${Math.round((100 * t) / split)}%`; await frame(); }
      }
      for (let i = 0; i < D; i++) for (let j = i + 1; j < D; j++) A[j * D + i] = A[i * D + j];
      $('.status').textContent = 'solving';
      await frame();
      let tr = 0; for (let i = 0; i < D; i++) tr += A[i * D + i];
      m.Wout = ridgeSolve(A, B, D, V, 1e-4 * tr / D);
      // input-only readout: the (V+1)x(V+1) block of the same normal equations
      const Db = V + 1, Ab = new Float64Array(Db * Db), Bb = new Float64Array(Db * V);
      for (let i = 0; i < Db; i++) {
        for (let j = 0; j < Db; j++) Ab[i * Db + j] = A[(n + i) * D + n + j];
        for (let k = 0; k < V; k++) Bb[i * V + k] = B[(n + i) * V + k];
      }
      const Wb = ridgeSolve(Ab, Bb, Db, V, 1e-4 * tr / D);
      // held-out accuracy
      let hitR = 0, hitB = 0, cnt = 0;
      for (let t = split - 1; t < L - 1; t++) {
        step(m, r, ids[t], tmp);
        const c = ids[t];
        let best = -1e9, arg = 0, bestB = -1e9, argB = 0;
        for (let k = 0; k < V; k++) {
          let s = m.Wout[(n + c) * V + k] + m.Wout[(D - 1) * V + k];
          for (let i = 0; i < n; i++) s += r[i] * m.Wout[i * V + k];
          if (s > best) { best = s; arg = k; }
          const sb = Wb[c * V + k] + Wb[V * V + k];
          if (sb > bestB) { bestB = sb; argB = k; }
        }
        if (arg === ids[t + 1]) hitR++;
        if (argB === ids[t + 1]) hitB++;
        cnt++;
      }
      model = m;
      $('.acc-res').textContent = `${((100 * hitR) / cnt).toFixed(1)} %`;
      $('.acc-bi').textContent = `${((100 * hitB) / cnt).toFixed(1)} %`;
      $('.status').textContent = 'done';
      $('.timing').textContent = `${n} units · ${(performance.now() - t0) / 1000 < 10 ? ((performance.now() - t0) / 1000).toFixed(1) : '>10'} s on this device`;
      busy = false;
      generate();
    }

    // generation
    let gen: null | { r: Float32Array; tmp: Float32Array; last: number; left: number } = null;
    const outP = $('.p'), outG = $('.g');
    function generate() {
      if (!model) return;
      const prompt = (root.querySelector<HTMLInputElement>('input[name="prompt"]')!.value || 'to be').toLowerCase();
      const r = new Float32Array(model.N), tmp = new Float32Array(model.N);
      let last = idx.get(' ')!;
      for (const ch of prompt) { const c = idx.get(ch); if (c === undefined) continue; step(model, r, c, tmp); last = c; }
      outP.textContent = prompt;
      outG.textContent = '';
      clearStates();
      gen = { r, tmp, last, left: 420 };
    }
    const sampler = rng(11);
    let acc = 0;
    visibleLoop(root, (dt) => {
      if (!gen || !model || gen.left <= 0) return;
      acc += dt * 45;
      while (acc >= 1 && gen.left > 0) {
        acc -= 1;
        const m = model, n = m.N, D = n + V + 1;
        const logits = new Float64Array(V);
        let mx = -1e9;
        for (let k = 0; k < V; k++) {
          let s = m.Wout[(n + gen.last) * V + k] + m.Wout[(D - 1) * V + k];
          for (let i = 0; i < n; i++) s += gen.r[i] * m.Wout[i * V + k];
          logits[k] = s / temp;
          if (logits[k] > mx) mx = logits[k];
        }
        let z = 0;
        for (let k = 0; k < V; k++) { logits[k] = Math.exp(logits[k] - mx); z += logits[k]; }
        let u = sampler.next() * z, c = 0;
        while (c < V - 1 && (u -= logits[c]) > 0) c++;
        outG.textContent += vocab[c];
        step(m, gen.r, c, gen.tmp);
        gen.last = c;
        gen.left--;
        drawState(gen.r);
      }
    });

    bindRange(root, 'n', (v) => String(v), (v) => { N = v; });
    bindRange(root, 'rho', (v) => v.toFixed(2), (v) => { rho = v; });
    bindRange(root, 'temp', (v) => v.toFixed(2), (v) => { temp = v; });
    $('[data-act="train"]').addEventListener('click', train);
    $('[data-act="gen"]').addEventListener('click', generate);
    root.querySelector('input[name="prompt"]')!.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') generate(); });
    new IntersectionObserver((e, obs) => { if (e[0].isIntersecting) { obs.disconnect(); setTimeout(train, 150); } }).observe(root);
  });
</script>

<style>
  .rtext { display: grid; gap: 16px; }
  .prompt input { width: 200px; min-height: 36px; padding: 0 12px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface-strong); color: var(--text); font-family: "SFMono-Regular", Consolas, monospace; font-size: .86rem; }
  .scores { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .score { display: grid; gap: 2px; padding: 12px 14px; background: var(--surface-strong); }
  .score span { color: var(--muted); font-size: .76rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
  .score b { font-size: 1.5rem; letter-spacing: -0.02em; }
  .score em { color: var(--muted); font-style: normal; font-size: .8rem; }
  .out { margin: 0; min-height: 9.5em; max-height: 16em; overflow: auto; padding: 16px 18px; border-radius: 14px; background: var(--media-bg); color: #eef1ea; font-size: .92rem; line-height: 1.55; white-space: pre-wrap; }
  .out .p { color: #e3a857; }
  .cursor { color: #9dc6b5; animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (max-width: 640px) { .scores { grid-template-columns: 1fr; } }
</style>
