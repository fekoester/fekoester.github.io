---
import DemoFrame from '../DemoFrame.astro';
---
<DemoFrame title="One FitzHugh–Nagumo neuron, in its phase plane">
  <div slot="intro">
    <p>The network in this project is built from these units. With little input current the neuron rests. A kick beyond threshold fires one large excursion, a spike, and it returns. With more current the rest state turns unstable and the neuron fires periodically. Click anywhere in the plane to start a trajectory there.</p>
  </div>
  <div class="fhn" data-demo="fhn">
    <div class="demo-controls">
      <label>input current I <input type="range" name="I" id="fhn-i" min="0" max="1.6" step="0.01" value="0.2" /><output for="fhn-i"></output></label>
      <label>a <input type="range" name="a" id="fhn-a" min="0.4" max="1.1" step="0.01" value="0.7" /><output for="fhn-a"></output></label>
      <button class="demo-btn primary" data-act="kick">Kick (+0.8 to v)</button>
    </div>
    <div class="panes">
      <canvas class="demo-canvas plane" aria-label="Phase plane of v and w with nullclines and trajectory"></canvas>
      <canvas class="demo-canvas trace" aria-label="Membrane voltage v over time"></canvas>
    </div>
    <div class="demo-readout">
      <span>regime: <b class="regime">–</b></span>
      <span><span class="legend-dot" style="background:#7fb0d8"></span>v-nullcline</span>
      <span><span class="legend-dot" style="background:#a99ad6"></span>w-nullcline</span>
      <span><span class="legend-dot" style="background:#e3a857"></span>trajectory</span>
    </div>
  </div>
  <div slot="foot"><p>v̇ = v − v³/3 − w + I, τẇ = v + a − b·w with b = 0.8, τ = 12.5. The regime label comes from the eigenvalues at the fixed point.</p></div>
</DemoFrame>

<script>
  import { setupCanvas, bindRange, visibleLoop, MEDIA } from '../../lib/demo';

  document.querySelectorAll<HTMLElement>('[data-demo="fhn"]').forEach((root) => {
    const B = 0.8, TAU = 12.5, VR: [number, number] = [-2.6, 2.6], WR: [number, number] = [-1.0, 2.2];
    let I = 0.2, a = 0.7;
    let v = -1.2, w = -0.6;
    const trail: [number, number][] = [];
    const vt: number[] = [];
    const pl = setupCanvas(root.querySelector<HTMLCanvasElement>('.plane')!, 1.3, () => draw());
    const tr = setupCanvas(root.querySelector<HTMLCanvasElement>('.trace')!, 1.3, () => draw());

    const fixedPoint = () => {
      // v - v^3/3 - (v + a)/b + I = 0, solve by bisection on the monotone-ish cubic
      let lo = -3, hi = 3;
      const g = (x: number) => x - x ** 3 / 3 - (x + a) / B + I;
      for (let k = 0; k < 80; k++) { const m = (lo + hi) / 2; if (g(lo) * g(m) <= 0) hi = m; else lo = m; }
      const vs = (lo + hi) / 2;
      const trace = 1 - vs * vs - B / TAU, det = (-B / TAU) * (1 - vs * vs) + 1 / TAU;
      return { v: vs, w: (vs + a) / B, stable: trace < 0 && det > 0 };
    };
    const regime = () => {
      const fp = fixedPoint();
      root.querySelector('.regime')!.textContent = fp.stable ? 'excitable: stable rest state, kick it to spike' : 'oscillating: rest state unstable, limit cycle';
    };

    const px = (vv: number) => ((vv - VR[0]) / (VR[1] - VR[0])) * pl.w;
    const py = (ww: number) => pl.h - ((ww - WR[0]) / (WR[1] - WR[0])) * pl.h;
    function draw() {
      if (!pl.w || !tr.w) return;
      const ctx = pl.ctx;
      ctx.fillStyle = MEDIA.bg; ctx.fillRect(0, 0, pl.w, pl.h);
      // flow field
      ctx.strokeStyle = 'rgba(157,198,181,0.28)'; ctx.lineWidth = 1;
      for (let i = 0; i <= 22; i++) for (let j = 0; j <= 14; j++) {
        const vv = VR[0] + ((i + 0.5) / 23) * (VR[1] - VR[0]), ww = WR[0] + ((j + 0.5) / 15) * (WR[1] - WR[0]);
        let dv = vv - vv ** 3 / 3 - ww + I, dw = ((vv + a - B * ww) / TAU) * 6;
        const n = Math.hypot(dv, dw) || 1; dv /= n; dw /= n;
        const x0 = px(vv), y0 = py(ww), L = 7;
        ctx.beginPath(); ctx.moveTo(x0 - dv * L, y0 + dw * L); ctx.lineTo(x0 + dv * L, y0 - dw * L); ctx.stroke();
      }
      // nullclines
      ctx.lineWidth = 2;
      ctx.strokeStyle = MEDIA.sky; ctx.beginPath();
      for (let i = 0; i <= 200; i++) { const vv = VR[0] + (i / 200) * (VR[1] - VR[0]); const ww = vv - vv ** 3 / 3 + I; i ? ctx.lineTo(px(vv), py(ww)) : ctx.moveTo(px(vv), py(ww)); }
      ctx.stroke();
      ctx.strokeStyle = MEDIA.violet; ctx.beginPath();
      ctx.moveTo(px(VR[0]), py((VR[0] + a) / B)); ctx.lineTo(px(VR[1]), py((VR[1] + a) / B)); ctx.stroke();
      const fp = fixedPoint();
      ctx.lineWidth = 2; ctx.strokeStyle = MEDIA.text; ctx.fillStyle = fp.stable ? MEDIA.text : MEDIA.bg;
      ctx.beginPath(); ctx.arc(px(fp.v), py(fp.w), 5, 0, 6.283); ctx.fill(); ctx.stroke();
      // trail
      for (let k = 1; k < trail.length; k++) {
        ctx.strokeStyle = `rgba(227,168,87,${(k / trail.length).toFixed(3)})`; ctx.lineWidth = 2.2;
        ctx.beginPath(); ctx.moveTo(px(trail[k - 1][0]), py(trail[k - 1][1])); ctx.lineTo(px(trail[k][0]), py(trail[k][1])); ctx.stroke();
      }
      ctx.fillStyle = MEDIA.amber; ctx.beginPath(); ctx.arc(px(v), py(w), 5, 0, 6.283); ctx.fill();
      ctx.fillStyle = MEDIA.muted; ctx.font = '11px Inter, system-ui, sans-serif'; ctx.textAlign = 'right';
      ctx.fillText('v →', pl.w - 8, pl.h - 8); ctx.textAlign = 'left'; ctx.fillText('↑ w', 8, 14);
      // v(t)
      const c2 = tr.ctx;
      c2.fillStyle = MEDIA.bg; c2.fillRect(0, 0, tr.w, tr.h);
      c2.strokeStyle = MEDIA.grid; c2.lineWidth = 1;
      const ty = (vv: number) => tr.h / 2 - (vv / 2.6) * (tr.h / 2 - 12);
      c2.beginPath(); c2.moveTo(0, ty(0)); c2.lineTo(tr.w, ty(0)); c2.stroke();
      c2.strokeStyle = MEDIA.amber; c2.lineWidth = 2; c2.beginPath();
      vt.forEach((vv, k) => { const X = (k / 599) * tr.w; k ? c2.lineTo(X, ty(vv)) : c2.moveTo(X, ty(vv)); });
      c2.stroke();
      c2.fillStyle = MEDIA.muted; c2.font = '11px Inter, system-ui, sans-serif'; c2.fillText('v(t)', 8, 14);
    }

    visibleLoop(root, () => {
      for (let k = 0; k < 8; k++) {
        const h = 0.02;
        const f = (vv: number, ww: number) => [vv - vv ** 3 / 3 - ww + I, (vv + a - B * ww) / TAU];
        const [a1, b1] = f(v, w), [a2, b2] = f(v + (h / 2) * a1, w + (h / 2) * b1), [a3, b3] = f(v + (h / 2) * a2, w + (h / 2) * b2), [a4, b4] = f(v + h * a3, w + h * b3);
        v += (h / 6) * (a1 + 2 * a2 + 2 * a3 + a4); w += (h / 6) * (b1 + 2 * b2 + 2 * b3 + b4);
      }
      trail.push([v, w]); if (trail.length > 220) trail.shift();
      vt.push(v); if (vt.length > 600) vt.shift();
      draw();
    });
    root.querySelector<HTMLCanvasElement>('.plane')!.addEventListener('click', (e) => {
      const rect = (e.currentTarget as HTMLCanvasElement).getBoundingClientRect();
      v = VR[0] + ((e.clientX - rect.left) / rect.width) * (VR[1] - VR[0]);
      w = WR[0] + (1 - (e.clientY - rect.top) / rect.height) * (WR[1] - WR[0]);
      trail.length = 0;
    });
    root.querySelector('[data-act="kick"]')!.addEventListener('click', () => { v += 0.8; });
    bindRange(root, 'I', (x) => x.toFixed(2), (x) => { I = x; regime(); draw(); });
    bindRange(root, 'a', (x) => x.toFixed(2), (x) => { a = x; regime(); draw(); });
    regime();
  });
</script>

<style>
  .fhn { display: grid; gap: 14px; }
  .panes { display: grid; grid-template-columns: 1.2fr 1fr; gap: 12px; }
  .plane { cursor: crosshair; }
  @media (max-width: 680px) { .panes { grid-template-columns: 1fr; } }
</style>
