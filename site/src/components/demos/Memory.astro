---
import DemoFrame from '../DemoFrame.astro';
---
<DemoFrame title="How much does a reservoir remember?">
  <div slot="intro">
    <p>Drive a reservoir of N nodes with random input u(t) and ask a linear readout to recall u(t − k). The squared correlation it achieves is the memory function m(k); its sum is the linear memory capacity, which can never exceed N. A small input keeps the nodes nearly linear; a large one makes them nonlinear, and they forget faster.</p>
  </div>
  <div class="mem" data-demo="memory">
    <div class="demo-controls">
      <label>nodes N <input type="range" name="n" id="mm-n" min="5" max="80" step="1" value="30" /><output for="mm-n"></output></label>
      <label>spectral radius <input type="range" name="rho" id="mm-rho" min="0.05" max="1.3" step="0.01" value="0.9" /><output for="mm-rho"></output></label>
      <label>input scale <input type="range" name="sig" id="mm-sig" min="0.01" max="2" step="0.01" value="0.1" /><output for="mm-sig"></output></label>
    </div>
    <div class="panes">
      <figure><canvas class="demo-canvas c1" aria-label="Memory function m(k) against the delay k"></canvas><figcaption>Memory function m(k)</figcaption></figure>
      <figure><canvas class="demo-canvas c2" aria-label="Total memory capacity against the spectral radius"></canvas><figcaption>Total capacity vs spectral radius (same N and input)</figcaption></figure>
    </div>
    <div class="demo-readout">
      <span>total linear memory capacity: <b class="mc">–</b></span>
      <span>bound: <b class="bound">–</b></span>
    </div>
  </div>
  <div slot="foot"><p>Computed from 2,000 steps of simulation in your browser. For delay-based reservoirs, the master memory function gets the same curve from the linearised system directly, without simulating.</p></div>
</DemoFrame>

<script>
  import { setupCanvas, palette, onThemeChange, axes, bindRange, rng, reservoirMatrix, ridgeSolve } from '../../lib/demo';

  document.querySelectorAll<HTMLElement>('[data-demo="memory"]').forEach((root) => {
    const T = 2000, WASH = 100;
    let N = 30, rho = 0.9, sig = 0.1;
    const c1 = setupCanvas(root.querySelector<HTMLCanvasElement>('.c1')!, 1.5, () => draw());
    const c2 = setupCanvas(root.querySelector<HTMLCanvasElement>('.c2')!, 1.5, () => draw());
    const R0 = rng(5);
    const u = new Float64Array(T).map(() => R0.next() * 2 - 1);
    let varU = 0; for (let t = 0; t < T; t++) varU += u[t] * u[t]; varU /= T;

    /** memory function of a tanh reservoir with radius `r` (fixed random structure per N). */
    function memory(n: number, r: number, s: number, K: number) {
      const R = rng(1000 + n);
      const W = reservoirMatrix(n, 1, r, R);
      const win = new Float64Array(n).map(() => (R.next() * 2 - 1));
      const X = new Float64Array((T - WASH) * n);
      let x = new Float64Array(n);
      const nx = new Float64Array(n);
      for (let t = 0; t < T; t++) {
        for (let i = 0; i < n; i++) {
          let a = s * win[i] * u[t];
          for (let j = 0; j < n; j++) a += W[i * n + j] * x[j];
          nx[i] = Math.tanh(a);
        }
        x.set(nx);
        if (t >= WASH) X.set(x, (t - WASH) * n);
      }
      const M = T - WASH;
      const C = new Float64Array(n * n), V = new Float64Array(n * K);
      for (let t = 0; t < M; t++) {
        const row = t * n;
        for (let i = 0; i < n; i++) { const xi = X[row + i]; for (let j = i; j < n; j++) C[i * n + j] += xi * X[row + j]; }
      }
      // x(t) has seen u(t) as its newest input; delay k = 1 recalls u(t), delay k recalls u(t - k + 1)
      for (let t = 0; t < M; t++) {
        const row = t * n, tt = t + WASH;
        for (let k = 1; k <= K; k++) {
          const target = tt - k + 1 >= 0 ? u[tt - k + 1] : 0;
          for (let i = 0; i < n; i++) V[i * K + k - 1] += X[row + i] * target;
        }
      }
      for (let i = 0; i < n; i++) for (let j = i + 1; j < n; j++) C[j * n + i] = C[i * n + j];
      let tr = 0; for (let i = 0; i < n; i++) tr += C[i * n + i];
      const Z = ridgeSolve(C, V, n, K, 1e-9 * tr / n);
      const m = new Float64Array(K);
      for (let k = 0; k < K; k++) {
        let s2 = 0; for (let i = 0; i < n; i++) s2 += V[i * K + k] * Z[i * K + k];
        m[k] = Math.max(0, Math.min(1, s2 / (M * varU)));
      }
      return m;
    }

    let mfun = new Float64Array(0), sweep: { r: number; mc: number }[] = [], sweepKey = '';
    function compute(full: boolean) {
      const K = Math.min(2 * N + 10, 120);
      mfun = memory(N, rho, sig, K);
      const key = `${N}|${sig}`;
      if (full || key !== sweepKey) {
        sweepKey = key;
        sweep = [];
        for (let r = 0.1; r <= 1.301; r += 0.2) { const mm = memory(N, r, sig, K); sweep.push({ r, mc: mm.reduce((a, b) => a + b, 0) }); }
      }
      draw();
    }

    function draw() {
      if (!c1.w || !c2.w || !mfun.length) return;
      const pal = palette();
      const K = mfun.length;
      const total = mfun.reduce((a, b) => a + b, 0);
      {
        const { ctx, w, h } = c1;
        ctx.clearRect(0, 0, w, h); ctx.fillStyle = pal.surface; ctx.fillRect(0, 0, w, h);
        const box = { x: 44, y: 14, w: w - 58, h: h - 54 };
        const { tx, ty } = axes(ctx, box, [0, K + 1], [0, 1], {
          color: pal.muted, grid: pal.line, yticks: [0, 0.5, 1], xticks: [1, Math.round(K / 4), Math.round(K / 2), Math.round((3 * K) / 4), K], xlabel: 'delay k',
        });
        const bw = Math.max(1, (box.w / (K + 1)) * 0.8);
        ctx.fillStyle = pal.accent;
        for (let k = 0; k < K; k++) ctx.fillRect(tx(k + 1) - bw / 2, ty(mfun[k]), bw, ty(0) - ty(mfun[k]));
        ctx.setLineDash([4, 4]); ctx.strokeStyle = pal.amber; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(tx(N), box.y); ctx.lineTo(tx(N), box.y + box.h); ctx.stroke(); ctx.setLineDash([]);
        ctx.fillStyle = pal.amber; ctx.font = '12px Inter, system-ui, sans-serif'; ctx.textAlign = 'left';
        ctx.fillText('k = N', tx(N) + 5, box.y + 12);
      }
      {
        const { ctx, w, h } = c2;
        ctx.clearRect(0, 0, w, h); ctx.fillStyle = pal.surface; ctx.fillRect(0, 0, w, h);
        const box = { x: 44, y: 14, w: w - 58, h: h - 54 };
        const { tx, ty } = axes(ctx, box, [0.1, 1.3], [0, N * 1.05], {
          color: pal.muted, grid: pal.line, xticks: [0.2, 0.6, 1.0], yticks: [0, Math.round(N / 2), N], xlabel: 'spectral radius',
        });
        ctx.setLineDash([4, 4]); ctx.strokeStyle = pal.amber; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(box.x, ty(N)); ctx.lineTo(box.x + box.w, ty(N)); ctx.stroke(); ctx.setLineDash([]);
        ctx.fillStyle = pal.amber; ctx.font = '12px Inter, system-ui, sans-serif'; ctx.textAlign = 'left'; ctx.fillText('MC ≤ N', box.x + 6, ty(N) + 14);
        ctx.strokeStyle = pal.accent; ctx.lineWidth = 2.5; ctx.beginPath();
        sweep.forEach((p, i) => (i ? ctx.lineTo(tx(p.r), ty(p.mc)) : ctx.moveTo(tx(p.r), ty(p.mc))));
        ctx.stroke();
        ctx.fillStyle = pal.coral; ctx.beginPath(); ctx.arc(tx(Math.min(1.3, Math.max(0.1, rho))), ty(total), 6, 0, 7); ctx.fill();
      }
      root.querySelector('.mc')!.textContent = total.toFixed(1);
      root.querySelector('.bound')!.textContent = `N = ${N}`;
    }

    let pending = 0;
    const schedule = () => { cancelAnimationFrame(pending); pending = requestAnimationFrame(() => compute(false)); };
    bindRange(root, 'n', (v) => String(v), (v) => { N = v; schedule(); });
    bindRange(root, 'rho', (v) => v.toFixed(2), (v) => { rho = v; schedule(); });
    bindRange(root, 'sig', (v) => v.toFixed(2), (v) => { sig = v; schedule(); });
    onThemeChange(draw);
    new IntersectionObserver((e, obs) => { if (e[0].isIntersecting) { obs.disconnect(); compute(true); } }).observe(root);
  });
</script>

<style>
  .mem { display: grid; gap: 14px; }
  .panes { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .panes figure { margin: 0; }
  .panes figcaption { margin-top: 6px; color: var(--muted); font-size: .82rem; }
  .panes :global(.demo-canvas) { background: var(--surface-strong); border: 1px solid var(--line); }
  @media (max-width: 680px) { .panes { grid-template-columns: 1fr; } }
</style>
